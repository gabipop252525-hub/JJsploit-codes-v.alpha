--[[
    BULLY1L V0.6 PRECEDENT 
    The "Actually Works" Edition
--]]

local ScreenGui = Instance.new("ScreenGui")
local Main = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local TargetInput = Instance.new("TextBox")
local FlingBtn = Instance.new("TextButton")
local BToolsBtn = Instance.new("TextButton")
local SpeedBtn = Instance.new("TextButton")
local InvisibleBtn = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

-- UI SETUP (Classic Exploiter Style)
ScreenGui.Parent = game:GetService("CoreGui")
Main.Name = "Bully1L_Precedent"
Main.Parent = ScreenGui
Main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Main.BorderSizePixel = 0
Main.Position = UDim2.new(0.5, -100, 0.5, -125)
Main.Size = UDim2.new(0, 200, 0, 300)
Main.Active = true
Main.Draggable = true
UICorner.Parent = Main

Title.Text = "BULLY1L V0.6"
Title.Size = UDim2.new(1, 0, 0, 40)
Title.TextColor3 = Color3.fromRGB(255, 0, 50)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 22
Title.Parent = Main

local function makeBtn(text, pos, color)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(0.9, 0, 0, 35)
    b.Position = pos
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 16
    Instance.new("UICorner", b)
    return b
end

TargetInput.Parent = Main
TargetInput.PlaceholderText = "Target Name"
TargetInput.Size = UDim2.new(0.9, 0, 0, 30)
TargetInput.Position = UDim2.new(0.05, 0, 0.15, 0)
TargetInput.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
TargetInput.TextColor3 = Color3.new(1,1,1)

local flingB = makeBtn("KILL FLING", UDim2.new(0.05, 0, 0.3, 0), Color3.fromRGB(150, 0, 0))
local btoolsB = makeBtn("GIVE BTOOLS", UDim2.new(0.05, 0, 0.45, 0), Color3.fromRGB(0, 100, 200))
local speedB = makeBtn("SPEED (200)", UDim2.new(0.05, 0, 0.6, 0), Color3.fromRGB(0, 150, 100))
local invB = makeBtn("GHOST MODE", UDim2.new(0.05, 0, 0.75, 0), Color3.fromRGB(100, 100, 100))

--- CORE LOGIC ---

local lp = game.Players.LocalPlayer
local run = game:GetService("RunService")

-- 1. KILL FLING (Targeted Physics Glitch)
local flinging = false
flingB.MouseButton1Click:Connect(function()
    local targetName = TargetInput.Text:lower()
    local target = nil
    for _, v in pairs(game.Players:GetPlayers()) do
        if v.Name:lower():sub(1, #targetName) == targetName then target = v end
    end

    if target and target.Character then
        flinging = not flinging
        flingB.Text = flinging and "FLINGING..." or "KILL FLING"
        
        task.spawn(function()
            while flinging and target.Character and lp.Character do
                local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
                local thp = target.Character:FindFirstChild("HumanoidRootPart")
                if hrp and thp then
                    -- Teleports you into them while spinning
                    hrp.CFrame = thp.CFrame
                    hrp.Velocity = Vector3.new(5000, 5000, 5000)
                    hrp.RotVelocity = Vector3.new(5000, 5000, 5000)
                end
                run.Heartbeat:Wait()
            end
        end)
    end
end)

-- 2. BTOOLS
btoolsB.MouseButton1Click:Connect(function()
    for i = 1, 4 do
        local tool = Instance.new("HopperBin", lp.Backpack)
        tool.BinType = i
    end
end)

-- 3. SPEED
speedB.MouseButton1Click:Connect(function()
    lp.Character.Humanoid.WalkSpeed = 200
end)

-- 4. GHOST MODE (Semi-Invisible)
invB.MouseButton1Click:Connect(function()
    for _, v in pairs(lp.Character:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Decal") then
            v.Transparency = v.Transparency == 0 and 0.5 or 0
        end
    end
end)
